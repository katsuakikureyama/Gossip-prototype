# Pinned development-oracle inputs. Review/update deliberately; do not use
# `latest`, floating branches, production passwords, or production databases.
WORDPRESS_ORACLE_IMAGE=wordpress:6.6.2-php8.3-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-2.10.0-php8.3
WORDPRESS_MYSQL_IMAGE=mysql:8.4.3
COMPAT_RUNNER_IMAGE=curlimages/curl:8.11.0

# Host-only published ports. The container-network oracle URL is configured in
# compose.yaml and must remain separate from this browser-facing convenience URL.
GOSSIP_PORT=8080
WORDPRESS_ORACLE_PORT=8088
WORDPRESS_ORACLE_BROWSER_URL=http://localhost:8088

# Local fixture credentials only. Replace in a local ignored .env if desired;
# never point this compose project at an existing or production WordPress DB.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=gossip_oracle
WORDPRESS_DB_PASSWORD=gossip-oracle-local-only
WORDPRESS_DB_ROOT_PASSWORD=gossip-root-local-only
WORDPRESS_ORACLE_ADMIN_USER=oracle_admin
WORDPRESS_ORACLE_ADMIN_PASSWORD=oracle-admin-local-only
WORDPRESS_ORACLE_ADMIN_EMAIL=oracle@example.invalid

# Optional only after Gossip declares a versioned compatibility HTTP contract.
# REQUIRE_CANDIDATE=1 turns unavailable/mismatched candidate checks into a fail.
CANDIDATE_BASE_URL=
REQUIRE_CANDIDATE=0
